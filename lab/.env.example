# Generate distinct random values before starting the lab.
WEBUI_SECRET_KEY=replace-with-a-long-random-secret
OPEN_TERMINAL_API_KEY=replace-with-a-long-random-secret
OPEN_TERMINAL_OWNER_NAME=wenguang.wu

# Jira Cloud MCP. Generate an Atlassian API token for a dedicated service user.
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Lightweight ragflow knowledge platform. Embedding calls use Alibaba Bailian.
RAGFLOW_DASHSCOPE_API_KEY=
RAGFLOW_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAGFLOW_EMBEDDING_MODEL=text-embedding-v4
RAGFLOW_MCP_TOKEN=replace-with-a-long-random-secret

# Legacy administrator-approval route; requester confirmation is the lab default.
TOOL_GOVERNANCE_APPROVAL_PROJECT=OWUI
# JSON map: Open WebUI group name -> Jira Cloud accountId of its administrator.
TOOL_GOVERNANCE_GROUP_ADMIN_IDS={}

# The runtime requires Anthropic Messages plus tool_use, not just OpenAI API compatibility.
# Set a real model ID accepted by your chosen endpoint.
UPSTREAM_MODEL=replace-with-your-messages-compatible-model-id
UPSTREAM_API_BASE=https://api.anthropic.com
UPSTREAM_API_KEY=

# Third-party gateways are supported only when their Messages/tool_use behavior works.
# Configure all three UPSTREAM_* values together and verify a real tool call.
# The RAGFLOW_DASHSCOPE_BASE_URL above is for embeddings; it is not an SDK endpoint example.
# Configure coding_agent.VISUAL_REVIEW_MODEL in OWUI if the coding model lacks vision.
